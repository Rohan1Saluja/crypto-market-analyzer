+}
+
+function MilestoneRow({
+  label,
+  value,
+  change,
+  date,
+}: {
+  label: string;
+  value: string;
+  change: string;
+  date: string;
+}) {
+  return (
+    <div className="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
+      <div className="flex items-start justify-between gap-4">
