# Server-side FastAPI URL. Never expose this through NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000

# Auth0 Regular Web Application. None of these belong in NEXT_PUBLIC_.
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=generate-a-32-byte-hex-secret
AUTH0_AUDIENCE=https://api.calyrn.app
APP_BASE_URL=http://localhost:3000

# Canonical public URL used only for metadata and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
