CMA_APP_NAME=Calyrn API
CMA_API_V1_PREFIX=/api/v1
CMA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL. The local value matches compose.yaml.
CMA_DATABASE_URL=postgresql+psycopg://calyrn:calyrn@127.0.0.1:5432/calyrn
CMA_DATABASE_ECHO=false

# Auth0 resource-server validation. Domain must not include https://.
CMA_AUTH0_DOMAIN=your-tenant.region.auth0.com
CMA_AUTH0_AUDIENCE=https://api.calyrn.app
CMA_AUTH0_CLIENT_ID=your-client-id

# CoinGecko Demo API
CMA_COINGECKO_API_KEY=your-demo-key-here
CMA_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Alchemy Portfolio API. Use the Calyrn Dev key locally.
CMA_ALCHEMY_API_KEY=your-dev-api-key-here
CMA_ALCHEMY_BASE_URL=https://api.g.alchemy.com/data/v1

# Keep upstream usage comfortably below free-tier limits.
CMA_MARKET_CACHE_TTL_SECONDS=60
CMA_HISTORY_CACHE_TTL_SECONDS=300
CMA_RESEARCH_CACHE_TTL_SECONDS=300
CMA_NEWS_CACHE_TTL_SECONDS=300
